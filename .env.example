# ============================================================
#  RADIO OACV — configuration du serveur
#  Copiez ce fichier en « .env » puis remplissez-le.
#  Le plus simple : « npm run setup » (génère .env automatiquement).
#
#  .env n'est JAMAIS versionné : aucun secret ne doit se retrouver
#  sur GitHub. Sur un serveur, utilisez les variables d'environnement.
# ============================================================

# ---------- Réseau ----------
PORT=8123
HOST=0.0.0.0
# Fuseau horaire utilisé pour la programmation (tous les jours à 12h00…)
TZ_NAME=Europe/Paris
# Derrière un reverse proxy (VPS, Docker), mettez 1
TRUST_PROXY=0
# À mettre à 1 quand le site est en HTTPS (cookie de session chiffré)
SECURE_COOKIES=0

# ---------- Sécurité ----------
# Généré par « npm run setup » : ne le partagez avec personne.
SESSION_SECRET=
# Durée d'une session d'administration, en heures
SESSION_HOURS=12
# Taille maximale d'une annonce enregistrée, en Mo
UPLOAD_MAX_MB=25

# ---------- Administrateurs (exactement deux) ----------
# Les mots de passe ne sont JAMAIS stockés en clair : uniquement leur
# empreinte scrypt. « npm run setup » les génère pour vous.
ADMIN1_NAME=
ADMIN1_EMAIL=
ADMIN1_PASSWORD_HASH=
# ADMIN1 = propriétaire : accès complet, impossible à restreindre.

ADMIN2_NAME=
ADMIN2_EMAIL=
ADMIN2_PASSWORD_HASH=
# ADMIN2 = votre collègue : uniquement les permissions listées ici.
# Valeurs possibles : announcements, schedule, library, ads
ADMIN2_PERMS=announcements,schedule,library,ads
ADMIN2_ENABLED=1

# ---------- Antenne ----------
MUSIC_PLAYLIST_ID=PLuwwO2tW6rWqsDdYv16-YJyDrtDF3tRan
ADS_PLAYLIST_ID=PLTvT8EdA3MszcV7CoKdtCIgiHV_6lrgxg
PUBOACV_WEIGHT=4
MUSICS_BEFORE_BREAK_MIN=5
MUSICS_BEFORE_BREAK_MAX=7
LIBRARY_CACHE_HOURS=12

# ---------- Flux audio (phase serveur d'antenne) ----------
STREAM_MOUNT=/stream
STREAM_BITRATE=160k
# Adresse publique du flux, utilisée par le bot Discord.
# Exemple : https://radio.exemple.fr/stream
STREAM_PUBLIC_URL=
